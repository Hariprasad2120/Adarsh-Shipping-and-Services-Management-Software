{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accounting-import/v1",
  "title": "Accounting controlled import contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSystem", "sourceBatchIdentifier", "extractedAt", "targetOrganizationRef", "records"],
  "properties": {
    "schemaVersion": { "const": "accounting-import/v1" },
    "sourceSystem": { "$ref": "#/$defs/stableCode" },
    "sourceBatchIdentifier": { "$ref": "#/$defs/stableCode" },
    "extractedAt": { "type": "string", "format": "date-time" },
    "targetOrganizationRef": { "$ref": "#/$defs/stableCode" },
    "openingHistoryPolicy": { "$ref": "#/$defs/openingHistoryPolicy" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "stableCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "recordType": {
      "enum": [
        "LEGAL_ENTITY", "ORGANIZATION", "ACCOUNTING_PERIOD", "ACCOUNT",
        "CUSTOMER", "SUPPLIER", "CURRENCY", "EXCHANGE_RATE_REFERENCE",
        "OPENING_BALANCE", "SALES_INVOICE", "PURCHASE_INVOICE", "CREDIT_NOTE",
        "DEBIT_NOTE", "RECEIPT", "PAYMENT", "ALLOCATION", "JOURNAL_REFERENCE",
        "RECURRING_TEMPLATE", "DEPRECIATION_SOURCE", "PARTNER_TRANSACTION",
        "ATTACHMENT"
      ]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIdentifier", "relativePath", "mimeType", "sizeBytes", "sha256"],
      "properties": {
        "sourceIdentifier": { "$ref": "#/$defs/stableCode" },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "mimeType": { "enum": ["application/pdf", "image/jpeg", "image/png", "image/webp"] },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystem", "sourceRecordType", "sourceIdentifier",
        "targetOrganizationRef", "targetLegalEntityRef", "importBatch",
        "dependencies", "payload", "attachments"
      ],
      "properties": {
        "sourceSystem": { "$ref": "#/$defs/stableCode" },
        "sourceRecordType": { "$ref": "#/$defs/recordType" },
        "sourceIdentifier": { "$ref": "#/$defs/stableCode" },
        "sourceVersion": { "$ref": "#/$defs/stableCode" },
        "targetOrganizationRef": { "$ref": "#/$defs/stableCode" },
        "targetLegalEntityRef": { "$ref": "#/$defs/stableCode" },
        "importBatch": { "$ref": "#/$defs/stableCode" },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableCode" }
        },
        "payload": {
          "type": "object",
          "description": "Secret, credential, token, connection-string and database-URL keys are rejected."
        },
        "attachments": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    },
    "openingHistoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionStatus", "decisionReference", "migrationEffectiveDate",
        "historicalDepth", "openingReceivables", "openingPayables",
        "openingBankAndCash", "openingAccountBalances", "outstandingAllocations",
        "retainedEarningsTreatment", "comparativeReporting",
        "settledHistoricalDocuments", "taxAndStatutoryHistory",
        "foreignCurrencyBalances"
      ],
      "properties": {
        "decisionStatus": { "const": "ACCEPTED" },
        "decisionReference": { "$ref": "#/$defs/stableCode" },
        "migrationEffectiveDate": { "type": "string", "format": "date" },
        "historicalDepth": { "$ref": "#/$defs/policyText" },
        "openingReceivables": { "$ref": "#/$defs/policyText" },
        "openingPayables": { "$ref": "#/$defs/policyText" },
        "openingBankAndCash": { "$ref": "#/$defs/policyText" },
        "openingAccountBalances": { "$ref": "#/$defs/policyText" },
        "outstandingAllocations": { "$ref": "#/$defs/policyText" },
        "retainedEarningsTreatment": { "$ref": "#/$defs/policyText" },
        "comparativeReporting": { "$ref": "#/$defs/policyText" },
        "settledHistoricalDocuments": { "$ref": "#/$defs/policyText" },
        "taxAndStatutoryHistory": { "$ref": "#/$defs/policyText" },
        "foreignCurrencyBalances": { "$ref": "#/$defs/policyText" }
      }
    },
    "policyText": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}

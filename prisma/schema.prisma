model LeaveType {
  id              String  @id @default(cuid())
  orgId           String
  name            String
  paid            Boolean @default(true)
  defaultBalance  Decimal @default(0) @db.Decimal(10, 4)
  accrualRule     Json? // legacy, unused by new engine — kept for backward read compatibility
  code            String? // NEW — stable short code, e.g. "AL", "SL"; unique per org
  activeVersionId String? // NEW — points at the currently published LeavePolicyVersion
  isCompOffType   Boolean @default(false) // NEW — marks the org's comp-off-consumption leave type

  org      Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]
  versions LeavePolicyVersion[]
  ledgerEntries LeaveLedgerEntry[]
  grants   LeaveGrant[]

  @@unique([orgId, name])
  @@unique([orgId, code])
  @@index([orgId])
}

model LeaveBalance {
  id            String    @id @default(cuid())
  userId        String
  leaveTypeId   String
  year          Int
  balance       Decimal   @db.Decimal(10, 4)
  version       Int       @default(0) // NEW — optimistic lock for concurrent ledger writes
  updatedAt     DateTime  @default(now()) @updatedAt // NEW — default(now()) needed so ADD COLUMN NOT NULL is safe on existing rows
  nextResetDate DateTime? @db.Date // NEW — precomputed leave-year boundary for this balance row (calendar/financial/anniversary), so the daily reset cron does an indexed lookup instead of scanning + recomputing every employee's anniversary each run

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([nextResetDate])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  halfDay     Boolean  @default(false)
  status      String   @default("pending") // pending | approved | rejected | cancelled |
                                            // draft | submitted | pending_approval | cancel_pending |
                                            // extension_pending | withdrawn | expired
  approverId  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // NEW fields — additive, all nullable/defaulted so existing rows remain valid
  policyVersionId        String?
  computedDurationUnits   Decimal? @db.Decimal(10, 4)
  paidUnits               Decimal? @db.Decimal(10, 4)
  lopUnits                Decimal? @db.Decimal(10, 4)
  currentApprovalStepId   String?
  cancelledAt             DateTime?
  cancelReason             String?
  extendedFromRequestId    String?
  onDutyLocation           String? // NEW — for ON_DUTY classification: where the employee will be (client site, field visit, etc.)
  onDutyReference          String? // NEW — for ON_DUTY classification: client/job/ticket reference, free text

  user      User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver  User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  policyVersion    LeavePolicyVersion? @relation(fields: [policyVersionId], references: [id])
  extendedFrom     LeaveRequest?       @relation("LeaveExtension", fields: [extendedFromRequestId], references: [id])
  extensions       LeaveRequest[]      @relation("LeaveExtension")

  ledgerEntries   LeaveLedgerEntry[]
  approvalSteps   LeaveApprovalStep[]
  attachments     LeaveRequestAttachment[]

  @@index([userId])
  @@index([approverId])
  @@index([policyVersionId])
}

// ─── Leave Management: policy versioning, ledger, approval routing, comp-off ──

model LeavePolicyVersion {
  id                String    @id @default(cuid())
  leaveTypeId       String
  version           Int
  status            String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  classification    String    @default("PAID") // PAID | UNPAID | ON_DUTY | RESTRICTED_HOLIDAY | PARTIALLY_PAID
  entitlementModel  String    @default("FIXED") // FIXED | EXPERIENCE_BASED | GRANT_BASED | ATTENDANCE_BASED
  unit              String    @default("DAY") // DAY | HOUR
  roundingMode      String    @default("NONE") // NONE | NEAREST | UP | DOWN
  roundingIncrement Decimal?  @db.Decimal(10, 4)
  effectiveFrom     DateTime  @db.Date
  effectiveUntil    DateTime? @db.Date
  configuration     Json // Zod-validated structured config — see src/modules/leave/policy-config.schema.ts
  publishedAt       DateTime?
  publishedById     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leaveType          LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  applicabilityRules LeaveApplicabilityRule[]
  requests           LeaveRequest[]

  @@unique([leaveTypeId, version])
  @@index([leaveTypeId, status])
}

model LeaveApplicabilityRule {
  id              String   @id @default(cuid())
  policyVersionId String
  mode            String // INCLUDE | EXCLUDE
  dimension       String // BRANCH | DEPARTMENT | DIVISION | DESIGNATION | EMPLOYMENT_TYPE | EMPLOYEE
  value           String // matching id or literal value
  createdAt       DateTime @default(now())

  policyVersion LeavePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@index([policyVersionId])
}

model EmployeeLeaveOverride {
  id             String    @id @default(cuid())
  userId         String
  leaveTypeId    String
  field          String // MAX_BALANCE | EXTRA_ENTITLEMENT | RESTRICTION_EXEMPT | OPENING_BALANCE_CORRECTION
  value          Json
  reason         String
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime?
  actorId        String
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leaveTypeId])
}

model LeaveLedgerEntry {
  id              String   @id @default(cuid())
  orgId           String
  userId          String
  leaveTypeId     String
  policyVersionId String?
  type            String // OPENING_BALANCE | ACCRUAL | MANUAL_CREDIT | MANUAL_DEBIT | LEAVE_RESERVED |
                          // LEAVE_CONSUMED | LEAVE_RELEASED | CARRY_FORWARD | CARRY_FORWARD_EXPIRY |
                          // ENCASHMENT | RESET | COMP_OFF_CREDIT | COMP_OFF_EXPIRY | ADJUSTMENT |
                          // CANCELLATION_REVERSAL | POLICY_MIGRATION | IMPORT | LOP_CONVERSION
  quantity        Decimal @db.Decimal(10, 4) // signed: positive = credit, negative = debit
  unit            String @default("DAY") // DAY | HOUR
  effectiveDate   DateTime @db.Date
  balanceBefore   Decimal @db.Decimal(10, 4)
  balanceAfter    Decimal @db.Decimal(10, 4)
  requestId       String?
  source          String // SYSTEM | SCHEDULER | ADMIN | EMPLOYEE | IMPORT
  actorId         String?
  reason          String?
  metadata        Json?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  org       Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType     @relation(fields: [leaveTypeId], references: [id])
  request   LeaveRequest? @relation(fields: [requestId], references: [id])

  @@index([orgId, userId, leaveTypeId])
  @@index([userId, leaveTypeId, effectiveDate])
}

model LeaveApprovalStep {
  id             String    @id @default(cuid())
  requestId      String
  sequence       Int
  approverType   String // MANAGER | MANAGERS_MANAGER | DEPARTMENT_HEAD | ROLE | NAMED_USER | HR
  approverUserId String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED | DELEGATED
  decidedById    String?
  decidedAt      DateTime?
  comment        String?
  slaDueAt       DateTime?
  createdAt      DateTime  @default(now())

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, sequence])
}

model RestrictedHolidaySelection {

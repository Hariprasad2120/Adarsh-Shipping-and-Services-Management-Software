generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Organisation Structure ───────────────────────────────────────────────────

model Organisation {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  active               Boolean  @default(true)
  crmCallRetentionDays Int      @default(90)
  defaultJurisdictionCountry String? // NEW — fallback jurisdiction (spec §35) for employees whose branch has no jurisdiction set, or who have no branch
  defaultJurisdictionState   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  branches    Branch[]
  departments Department[]
  divisions   Division[]
  roles       Role[]
  users       User[]

  appraisalCycles        AppraisalCycle[]
  appraisalSchedules     AppraisalSchedule[]
  appraisalCriteria      AppraisalCriterion[]
  appraisalSelfTemplate  AppraisalSelfTemplate?
  appraisalSettings      OrgAppraisalSettings?
  leaveTypes             LeaveType[]
  leaveLedgerEntries     LeaveLedgerEntry[]
  compOffCredits         CompOffCredit[]
  leaveGrants            LeaveGrant[]
  leaveSchedulerRuns     LeaveSchedulerRun[]
  leaveApproverDelegations LeaveApproverDelegation[]
  restrictedHolidaySelections RestrictedHolidaySelection[]
  holidays               Holiday[]
  notifications          Notification[]
  notificationActivities NotificationActivity[]
  todoTasks              TodoTask[]
  announcements          Announcement[]
  employeeProfileFields  EmployeeProfileField[]
  employeeInvitations    EmployeeInvitation[]
  workReportSettings     WorkReportSettings?
  workReportFields       WorkReportField[]

  crmApprovalLogs       CrmApprovalLog[]
  crmWorkTimeLogs       CrmWorkTimeLog[]
  biometricSyncLogs     BiometricSyncLog[]
  workingCalendar       WorkingCalendar?
  otSettings            OtSettings?
  themeSettings         OrganisationThemeSettings?
  attendancePunchEvents AttendancePunchEvent[]
  shifts                Shift[]

  // Accounting Module Relations
  accounts                            Account[]
  fiscalYears                         FiscalYear[]
  journalEntries                      JournalEntry[]
  generalLedgers                      GeneralLedgerEntry[]
  salesInvoices                       SalesInvoice[]
  purchaseInvoices                    PurchaseInvoice[]
  paymentEntries                      PaymentEntry[]
  customerLedgers                     CustomerLedgerEntry[]
  supplierLedgers                     SupplierLedgerEntry[]
  accountingSettings                  AccountingSettings?
  accountingAuditLogs                 AccountingAuditLog[]
  payrollBatches                      PayrollBatch[]
  assets                              Asset[]
  assetDepreciations                  AssetDepreciationEntry[]
  jobCostings                         JobCosting[]
  quotations                          Quotation[]
  customerNotes                       CustomerNote[]
  vendorNotes                         VendorNote[]
  recurringExpenses                   RecurringExpense[]
  recurringExpenseRuns                RecurringExpenseRun[]
  recurringJournals                   RecurringJournal[]
  recurringSalesInvoiceProfiles       RecurringSalesInvoiceProfile[]
  recurringSalesInvoiceRuns           RecurringSalesInvoiceRun[]
  accountingCustomerAdvanceRequests   AccountingCustomerAdvanceRequest[]
  accountingCustomerAdvanceReceipts   AccountingCustomerAdvanceReceipt[]
  transactionLock                     TransactionLock?
  partnerAccounts                     PartnerAccount[]
  accountingProfile                   AccountingOrganisationProfile?
  accountingLegalEntities             AccountingLegalEntity[]
  accountingTaxRegistrations          AccountingTaxRegistration[]
  accountingPeriods                   AccountingPeriod[]
  accountingPeriodLockRequests        AccountingPeriodLockRequest[]
  accountingCurrencies                AccountingCurrency[]
  accountingExchangeRates             AccountingExchangeRate[]
  accountingAccountControls           AccountingAccountControl[]
  accountingDimensionDefinitions      AccountingDimensionDefinition[]
  accountingDimensionValues           AccountingDimensionValue[]
  accountingJournalLineDimensions     AccountingJournalLineDimension[]
  accountingApprovalPolicies          AccountingApprovalPolicy[]
  accountingNumberSeries              AccountingNumberSeries[]
  accountingIntegrationInbox          AccountingIntegrationInbox[]
  accountingIntegrationOutbox         AccountingIntegrationOutbox[]
  accountingRoundingPolicies          AccountingRoundingPolicy[]
  accountingSourceSnapshots           AccountingSourceSnapshot[]
  accountingPostingAttempts           AccountingPostingAttempt[]
  accountingPayrollRunSnapshots       AccountingPayrollRunSnapshot[]
  accountingDocumentPolicies          AccountingDocumentPolicy[]
  accountingTaxProfiles               AccountingTaxProfile[]
  accountingTaxRules                  AccountingTaxRule[]
  accountingTaxComponents             AccountingTaxComponent[]
  accountingStatutoryReturnProfiles   AccountingStatutoryReturnProfile[]
  accountingStatutoryFilingPeriods    AccountingStatutoryFilingPeriod[]
  accountingBankAccounts              AccountingBankAccount[]
  accountingBankStatementImports      AccountingBankStatementImport[]
  accountingBankStatementLines        AccountingBankStatementLine[]
  accountingBankMatches               AccountingBankMatch[]
  accountingReconciliationSessions    AccountingReconciliationSession[]
  accountingRecurringTemplates        AccountingRecurringTemplate[]
  accountingRecurringSchedules        AccountingRecurringSchedule[]
  accountingRecurringRuns             AccountingRecurringRun[]
  accountingFinancialAssets           AccountingFinancialAsset[]
  accountingAssetBooks                AccountingAssetBook[]
  accountingDepreciationRuns          AccountingDepreciationRun[]
  accountingPartners                  AccountingPartner[]
  accountingPartnerTerms              AccountingPartnerTerm[]
  accountingAppropriations            AccountingAppropriation[]
  accountingBudgets                   AccountingBudget[]
  accountingBudgetLines               AccountingBudgetLine[]
  accountingCustomerProfiles          AccountingCustomerProfile[]
  accountingVendorProfiles            AccountingVendorProfile[]
  accountingPaymentTerms              AccountingPaymentTerm[]
  accountingPaymentMethods            AccountingPaymentMethod[]
  accountingPriceLists                AccountingPriceList[]
  accountingUnitsOfMeasure            AccountingUnitOfMeasure[]
  accountingReportingTags             AccountingReportingTag[]
  accountingItemMasters               AccountingItemMaster[]
  accountingSourceMappingProfiles     AccountingSourceMappingProfile[]
  accountingPeriodCloseRuns           AccountingPeriodCloseRun[]
  accountingReportExportProfiles      AccountingReportExportProfile[]
  accountingPortalPublicationProfiles AccountingPortalPublicationProfile[]
  accountingCustomFieldDefinitions    AccountingCustomFieldDefinition[]
  accountingAutomationRules           AccountingAutomationRule[]
  accountingWorkspaceModules          AccountingWorkspaceModule[]
  accountingCapabilityPolicies        AccountingCapabilityPolicy[]         @relation("AccountingCapabilityPolicyOrg")
  accountingDocuments                 AccountingDocument[]
  accountingDocumentLines             AccountingDocumentLine[]
  accountingPayments                  AccountingPayment[]
  accountingPaymentAllocations        AccountingPaymentAllocation[]
  accountingScheduledOccurrences      AccountingScheduledOccurrence[]
  accountingCounterpartyScopes        AccountingCounterpartyEntityScope[]

  chaSettings                      ChaSettings?
  chaJobs                          ChaJob[]
  chaJobDeletionRequests           ChaJobDeletionRequest[]
  chaExpenseRequests               ChaExpenseRequest[]
  chaAuditLogs                     ChaAuditLog[]
  chaTeamGroups                    ChaTeamGroup[]
  chaBranchNumberingRules          ChaBranchNumberingRule[]
  chaShipmentTypes                 ChaShipmentType[]
  chaDocumentRequirementCategories ChaDocumentRequirementCategory[]
  filingWorkflowTemplates          FilingWorkflowTemplate[]
  chaCustomsMasterImportRuns       ChaCustomsMasterImportRun[]
  chaCustomsMasterValidationErrors ChaCustomsMasterValidationError[]
  chaRitcTariffMasters             ChaRitcTariffMaster[]
  chaCessRateMasters               ChaCessRateMaster[]
  chaRodtepRateMasters             ChaRodtepRateMaster[]
  chaRodtepEouRateMasters          ChaRodtepEouRateMaster[]
  chaRosctlRateMasters             ChaRosctlRateMaster[]
  chaDrawbackRateMasters           ChaDrawbackRateMaster[]
  chaSchemeCodeMasters             ChaSchemeCodeMaster[]
  chaSingleWindowCthMasters        ChaSingleWindowCthMaster[]
  chaAidcRateMasters               ChaAidcRateMaster[]
  chaBcdRateMasters                ChaBcdRateMaster[]
  chaCustomsNotificationMasters    ChaCustomsNotificationMaster[]
  chaSupportingDocumentMasters     ChaSupportingDocumentMaster[]
  chaUomMasters                    ChaUomMaster[]

  // Google Chat Integration
  googleChatSpaces        GoogleChatSpace[]
  googleChatSubscriptions GoogleChatSubscription[]
  googleChatDeliveries    GoogleChatDelivery[]

  // Google Workspace Communication Integration
  googleWorkspaceConnections GoogleWorkspaceConnection[]
  googleWorkspaceSettings    GoogleWorkspaceSetting[]
  jobWorkspaceProfiles       JobWorkspaceProfile[]
  communicationAuditEvents   CommunicationAuditEvent[]

  // Recruit Module
  recruitJobOpenings    RecruitJobOpening[]
  recruitCandidates     RecruitCandidate[]
  recruitApplications   RecruitApplication[]
  recruitAuditEvents    RecruitAuditEvent[]
  recruitSettings       RecruitSetting?
  recruitAutomationRuns RecruitAutomationRun[]

  customerPortalUsers                   CustomerPortalUser[]
  customerPortalInvitations             CustomerPortalInvitation[]
  customerPortalSessions                CustomerPortalSession[]
  customerPortalAuditLogs               CustomerPortalAuditLog[]
  customerPortalNotifications           CustomerPortalNotification[]
  customerPortalNotificationPreferences CustomerPortalNotificationPreference[]
  customerVisibleStageMappings          CustomerVisibleStageMapping[]
  customerDocumentSubmissions           CustomerDocumentSubmission[]
  customerQueryThreads                  CustomerQueryThread[]
  customerQueryMessages                 CustomerQueryMessage[]
  shipmentRatings                       ShipmentServiceRating[]
  shipmentRatingCategories              ShipmentRatingCategory[]
  customerChecklistResponses            CustomerChecklistResponse[]
  crmLeadSources                        CrmLeadSource[]
  crmEnquirySequences                   CrmEnquirySequence[]
  crmServiceEnquiries                   CrmServiceEnquiry[]
  units                                 Unit[]

  @@index([slug])
}

model Branch {
  id    String  @id @default(cuid())
  orgId String
  name  String
  code  String
  jurisdictionCountry String? // NEW — for deterministic statutory-compliance lookup (spec §35): the country this branch's employees are legally covered under
  jurisdictionState   String? // NEW — state/province within jurisdictionCountry, when the country has state-level leave law (e.g. India)

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users    User[]
  holidays Holiday[]

  // Accounting Module Relations
  accounts                          Account[]
  journalEntries                    JournalEntry[]
  generalLedgers                    GeneralLedgerEntry[]
  salesInvoices                     SalesInvoice[]
  purchaseInvoices                  PurchaseInvoice[]
  paymentEntries                    PaymentEntry[]
  customerLedgers                   CustomerLedgerEntry[]
  supplierLedgers                   SupplierLedgerEntry[]
  assets                            Asset[]
  jobCostings                       JobCosting[]
  quotations                        Quotation[]
  customerNotes                     CustomerNote[]
  vendorNotes                       VendorNote[]
  recurringExpenses                 RecurringExpense[]
  recurringJournals                 RecurringJournal[]
  recurringSalesInvoiceProfiles     RecurringSalesInvoiceProfile[]
  accountingCustomerAdvanceRequests AccountingCustomerAdvanceRequest[]

  chaJobs                ChaJob[]
  chaBranchNumberingRule ChaBranchNumberingRule?

  @@unique([orgId, code])
  @@index([orgId])
}

model Department {
  id    String @id @default(cuid())
  orgId String
  name  String
  code  String

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  divisions Division[]
  users     User[]

  @@unique([orgId, code])
  @@index([orgId])
}

model Division {
  id           String @id @default(cuid())
  orgId        String
  departmentId String
  name         String

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@unique([departmentId, name])
  @@index([orgId])
  @@index([departmentId])
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  isSystem Boolean @default(false)

  org               Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  userRoles         UserRole[]
  appraisalCriteria AppraisalCriterion[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  label String
  group String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  orgId           String?
  email           String    @unique
  passwordHash    String
  name            String
  active          Boolean   @default(true)
  isPlatformAdmin Boolean   @default(false)
  designation     String?
  branchId        String?
  departmentId    String?
  divisionId      String?
  managerId       String?
  tlId            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailVerifiedAt DateTime?
  activatedAt     DateTime?

  // Personal & Biometric mapping
  employeeNumber Int?      @unique
  firstName      String?
  lastName       String?
  dob            DateTime?
  gender         String?
  photo          String?
  employmentType String?
  personalPhone  String?
  aadhaar        String?
  pan            String?
  uan            String?
  bankName       String?
  bankAccount    String?
  ifsc           String?

  org        Organisation? @relation(fields: [orgId], references: [id])
  branch     Branch?       @relation(fields: [branchId], references: [id])
  department Department?   @relation(fields: [departmentId], references: [id])
  division   Division?     @relation(fields: [divisionId], references: [id])
  manager    User?         @relation("ManagerReports", fields: [managerId], references: [id])
  reports    User[]        @relation("ManagerReports")
  tl         User?         @relation("TLReports", fields: [tlId], references: [id])
  tlReports  User[]        @relation("TLReports")

  roles                   UserRole[]
  notifications           Notification[]
  notificationActivities  NotificationActivity[] @relation("NotificationActivityActor")
  employmentRecord        EmploymentRecord?
  employeeProfile         EmployeeHrmsProfile?
  employeeInvitations     EmployeeInvitation[]   @relation("EmployeeInvitationTarget")
  employeeInvitationsSent EmployeeInvitation[]   @relation("EmployeeInvitationSender")
  documents               Document[]
  todoTasks               TodoTask[]

  // Attendance & OT
  punches                 AttendancePunch[]
  punchEvents             AttendancePunchEvent[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]             @relation("LeaveRequester")
  leaveApprovals          LeaveRequest[]             @relation("LeaveApprover")
  leaveLedgerEntries       LeaveLedgerEntry[]
  leaveOverrides           EmployeeLeaveOverride[]
  compOffCredits           CompOffCredit[]
  leaveGrants              LeaveGrant[]
  leaveDelegationsGiven    LeaveApproverDelegation[] @relation("LeaveDelegationsGiven")
  leaveDelegationsReceived LeaveApproverDelegation[] @relation("LeaveDelegationsReceived")
  restrictedHolidaySelections RestrictedHolidaySelection[]
  otEntries               OTEntry[]                  @relation("OTEmployee")
  otApprovals             OTEntry[]                  @relation("OTApprover")
  otRecords               OtRecord[]                 @relation("EmployeeOtRecords")
  approvedOts             OtRecord[]                 @relation("OtApprovedBy")
  regularizations         AttendanceRegularization[] @relation("RegularizationEmployee")
  approvedRegularizations AttendanceRegularization[] @relation("RegularizationApprover")
  lopRecords              EmployeeLop[]              @relation("EmployeeLopRecords")
  triggeredSyncs          BiometricSyncLog[]         @relation("TriggeredSyncs")

  // AMS
  appraisals           Appraisal[]                 @relation("AppraisalEmployee")
  appraisalReviews     AppraisalReviewer[]
  managementReviews    ManagementReview[]
  meetingConfirmations AppraisalMeeting[]          @relation("MeetingConfirmedBy")
  meetingMinutes       MeetingMinute[]
  hikeDecisions        HikeDecision[]
  appraisalSchedules   AppraisalSchedule[]
  extensionRequests    AppraisalExtensionRequest[] @relation("ExtRequester")
  decidedExtensions    AppraisalExtensionRequest[] @relation("ExtDecider")
  rescheduledMeetings  MeetingReschedule[]         @relation("RescheduledBy")
  confirmedReschedules MeetingReschedule[]         @relation("RescheduleConfirmer")

  // CRM
  raisedTickets   CrmTicket[]        @relation("TicketRaiser")
  assignedTickets CrmTicket[]        @relation("TicketAssignee")
  ticketComments  CrmTicketComment[] @relation("CommentAuthor")

  passkeyResetRequests  PasskeyResetRequest[] @relation("PasskeyResetUser")
  passkeyResetDecisions PasskeyResetRequest[] @relation("PasskeyResetDecider")
  securityEvents        SecurityEvent[]
  sessions              UserSession[]
  passkeySetupRequired  Boolean?              @default(false)

  // CRM Module Back-Relations
  crmInvoicesApproved                       CrmInvoice[]                      @relation("CrmInvoiceApprover")
  crmApprovalLogsActed                      CrmApprovalLog[]                  @relation("CrmApprovalLogActor")
  crmLeadsOwned                             CrmLead[]                         @relation("CrmLeadOwner")
  crmContactsOwned                          CrmContact[]                      @relation("CrmContactOwner")
  crmAccountsOwned                          CrmAccount[]                      @relation("CrmAccountOwner")
  crmDealsOwned                             CrmDeal[]                         @relation("CrmDealOwner")
  crmActivitiesOwned                        CrmActivity[]                     @relation("CrmActivityOwner")
  crmInvoicesOwned                          CrmInvoice[]                      @relation("CrmInvoiceOwner")
  crmVendorsOwned                           CrmVendor[]                       @relation("CrmVendorOwner")
  crmProjectsOwned                          CrmProject[]                      @relation("CrmProjectOwner")
  incentiveEntriesForEmployee               IncentiveEntry[]                  @relation("IncentiveEntryEmployee")
  incentiveEntriesCreated                   IncentiveEntry[]                  @relation("IncentiveEntryCreator")
  incentiveEntriesProcessed                 IncentiveEntry[]                  @relation("IncentiveEntryProcessor")
  crmNotesCreated                           CrmNote[]                         @relation("CrmNoteCreator")
  crmAttachmentsCreated                     CrmAttachment[]                   @relation("CrmAttachmentCreator")
  accountingPeriodLocksRequested            AccountingPeriodLockRequest[]     @relation("AccountingPeriodLockRequester")
  accountingPeriodLocksDecided              AccountingPeriodLockRequest[]     @relation("AccountingPeriodLockDecider")
  accountingExchangeRatesApproved           AccountingExchangeRate[]          @relation("AccountingExchangeRateApprover")
  accountingStatutoryFilingPeriodsFiled     AccountingStatutoryFilingPeriod[]
  accountingBankStatementImportsCreated     AccountingBankStatementImport[]   @relation("AccountingBankStatementImportCreator")
  accountingBankMatchesCreated              AccountingBankMatch[]             @relation("AccountingBankMatchCreator")
  accountingReconciliationSessionsCompleted AccountingReconciliationSession[] @relation("AccountingReconciliationSessionCompleter")
  accountingRecurringTemplatesCreated       AccountingRecurringTemplate[]     @relation("AccountingRecurringTemplateCreator")
  accountingRecurringRunsProcessed          AccountingRecurringRun[]          @relation("AccountingRecurringRunProcessor")
  accountingFinancialAssetsCreated          AccountingFinancialAsset[]        @relation("AccountingFinancialAssetCreator")
  accountingDepreciationRunsProcessed       AccountingDepreciationRun[]       @relation("AccountingDepreciationRunProcessor")
  accountingPartnersCreated                 AccountingPartner[]               @relation("AccountingPartnerCreator")
  accountingAppropriationsCreated           AccountingAppropriation[]         @relation("AccountingAppropriationCreator")
  accountingBudgetsCreated                  AccountingBudget[]                @relation("AccountingBudgetCreator")
  accountingCapabilityPoliciesCreated       AccountingCapabilityPolicy[]      @relation("AccountingCapabilityPolicyCreator")
  accountingCapabilityPoliciesApproved      AccountingCapabilityPolicy[]      @relation("AccountingCapabilityPolicyApprover")
  accountingCapabilityPoliciesRejected      AccountingCapabilityPolicy[]      @relation("AccountingCapabilityPolicyRejector")
  accountingCapabilityPoliciesRevoked       AccountingCapabilityPolicy[]      @relation("AccountingCapabilityPolicyRevoker")
  crmTimelineCreated                        CrmTimelineEvent[]                @relation("CrmTimelineCreator")
  crmJdConfigs                              CrmLeadSourceJustdialConfig[]     @relation("CrmJdConfigOwner")
  crmExternalLeadsAssigned                  CrmExternalLeadSnapshot[]         @relation("CrmExternalLeadAssignee")
  crmLeadReminders                          CrmLeadReminder[]                 @relation("CrmLeadReminderUser")
  crmWorkTimeLogs                           CrmWorkTimeLog[]                  @relation("CrmWorkTimeLogUser")
  crmServiceEnquiriesAssigned               CrmServiceEnquiry[]               @relation("CrmServiceEnquiryAssignee")
  crmServiceEnquiriesManaged                CrmServiceEnquiry[]               @relation("CrmServiceEnquiryManager")
  crmServiceEnquiriesCreated                CrmServiceEnquiry[]               @relation("CrmServiceEnquiryCreator")
  crmServiceEnquiriesUpdated                CrmServiceEnquiry[]               @relation("CrmServiceEnquiryUpdater")
  salesInvoicesSalesperson                  SalesInvoice[]                    @relation("SalesInvoiceSalesperson")
  purchaseInvoicesSalesperson               PurchaseInvoice[]                 @relation("PurchaseInvoiceSalesperson")
  customerNotesSalesperson                  CustomerNote[]                    @relation("CustomerNoteSalesperson")
  vendorNotesSalesperson                    VendorNote[]                      @relation("VendorNoteSalesperson")

  // PeoplePlus HRMS Relations
  hrmsPreferences          EmployeePreference?
  hrmsContact              EmployeeContact?
  hrmsShiftAssignments     ShiftAssignment[]             @relation("UserShiftAssignments")
  hrmsPermissionRequests   AttendancePermissionRequest[] @relation("PermissionEmployee")
  hrmsOnDutyRequests       OnDutyRequest[]               @relation("OnDutyEmployee")
  hrmsTimesheetSubmissions TimesheetSubmission[]         @relation("TimesheetSubmissions")
  hrmsGoals                Goal[]                        @relation("EmployeeGoals")
  hrmsSkills               EmployeeSkill[]               @relation("EmployeeSkills")
  hrmsFeedbacksGiven       PerformanceFeedback[]         @relation("FeedbackGiven")
  hrmsFeedbacksReceived    PerformanceFeedback[]         @relation("FeedbackReceived")
  hrmsSalaryLetters        SalaryRevisionLetter[]        @relation("EmployeeSalaryLetters")
  hrmsCourseEnrollments    CourseEnrollment[]            @relation("CourseEnrollments")
  hrmsSurveyResponses      SurveyResponse[]              @relation("SurveyResponses")
  hrmsCases                HRCase[]                      @relation("HRCaseRaiser")
  hrmsAssignedCases        HRCase[]                      @relation("HRCaseAssignee")
  hrmsLetterRequests       HRLetterRequest[]             @relation("LetterRequests")
  hrmsTravelRequests       TravelRequest[]               @relation("TravelRequests")

  customerPortalInvitationsSent       CustomerPortalInvitation[]   @relation("CustomerPortalInvitationSender")
  customerPortalAuditLogsActed        CustomerPortalAuditLog[]     @relation("CustomerPortalAuditActor")
  customerDocumentSubmissionsReviewed CustomerDocumentSubmission[] @relation("CustomerDocumentSubmissionReviewer")
  customerQueryMessagesAuthored       CustomerQueryMessage[]       @relation("CustomerQueryMessageAuthor")
  shipmentRatingsFollowUpOwned        ShipmentServiceRating[]      @relation("ShipmentRatingFollowUpOwner")
  hrmsTasksAssigned                   HrmsTask[]                   @relation("HrmsTasksAssigned")
  hrmsTasksCreated                    HrmsTask[]                   @relation("HrmsTasksCreated")
  hrmsAuditLogs                       HrmsAuditLog[]               @relation("HrmsAuditLogs")
  hrmsWorkReports                     WorkReport[]                 @relation("UserWorkReports")
  workReportApprovals                 WorkReportApproval[]         @relation("WorkReportApprover")

  // HRMS Mobile Attendance & Tracking
  mobileDevices            MobileDevice[]            @relation("UserMobileDevices")
  faceEnrollment           EmployeeFaceEnrollment?   @relation("FaceEnrollment")
  attendanceSessions       AttendanceSession[]       @relation("AttendanceSessions")
  locationTrackingSessions LocationTrackingSession[] @relation("UserTrackingSessions")
  trackingAlerts           TrackingAlert[]           @relation("UserTrackingAlerts")
  fuelReimbursementClaims  FuelReimbursementClaim[]  @relation("UserFuelClaims")
  agreementAcceptances     UserAgreementAcceptance[] @relation("UserAgreementAcceptances")

  // Accounting Module Relations
  accountingAuditLogs AccountingAuditLog[]

  // CRM Mobile Call Tracking
  crmCallAttempts  CrmCallAttempt[]           @relation("CrmCallAttemptSalesperson")
  crmCallReviews   CrmCallReview[]            @relation("CrmCallReviewer")
  crmCallAuditLogs CrmCallRecordingAuditLog[] @relation("CrmCallAuditLogUser")

  // Google Workspace Relations

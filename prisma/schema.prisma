model WorkReportApproval {
  id         String     @id @default(cuid())
  reportId   String
  approverId String
  level      Int        @default(1)
  status     String     @default("PENDING") // WAITING | PENDING | APPROVED | REJECTED | CANCELLED
  comments   String?
  decidedAt  DateTime?
  createdAt  DateTime   @default(now())
  report     WorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approver   User       @relation("WorkReportApprover", fields: [approverId], references: [id], onDelete: Cascade)


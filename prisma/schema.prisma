  workedOn           String // "Office" | "Home" | "Others"
  jobNoName          String
  description        String
  items              Json?
  customValues       Json?
  status             String               @default("PENDING") // PENDING | APPROVED | REJECTED
  addedAddress       String?
  modifiedAddress    String?
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  locationCapturedAt DateTime?
  createdAt          DateTime             @default(now())

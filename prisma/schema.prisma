  orgId       String
  userId      String
  holidayId   String
  leaveTypeId String // the RESTRICTED_HOLIDAY-classified policy this selection consumes
  year        Int
  status      String   @default("SELECTED") // SELECTED | APPROVED | REJECTED | CANCELLED

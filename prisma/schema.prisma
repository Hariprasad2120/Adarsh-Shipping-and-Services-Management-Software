  updatedAt                  DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model WorkReportField {
  id        String   @id @default(cuid())
  orgId     String
  key       String
  label     String
  type      String   @default("TEXT") // TEXT | TEXTAREA | NUMBER | DATE | SELECT | BOOLEAN
  required  Boolean  @default(false)
  options   Json?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId, active, position])
}

// ─── Accounting Module ──────────────────────────────────────────────────────────

enum AccountingInventoryMode {
  DISABLED
  SERVICE_ONLY
  INVENTORY_ONLY
  MIXED
}

enum AccountingRoundingMode {
  HALF_UP
}

enum AccountingLegalEntityStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AccountingPeriodStatus {
  OPEN
  SOFT_LOCKED
  HARD_LOCKED
  CLOSED
}

enum AccountingPeriodLockRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  APPLIED
  CANCELLED
}

enum AccountingExchangeRateStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum AccountingIntegrationMessageStatus {
  RECEIVED
  PENDING
  PROCESSING
  PROCESSED
  REJECTED
  RETRYABLE
  FAILED
  DEAD_LETTER
  MANUAL_REVIEW
}

enum AccountingPostingAttemptStatus {
  PROCESSING
  POSTED
  REJECTED
  RETRYABLE
  FAILED
}

enum AccountingMigrationBatchStatus {
  RECEIVED
  VALIDATING
  DRY_RUN_READY
  EXECUTING
  RECONCILING
  COMPLETED
  FAILED
  QUARANTINED
}

enum AccountingMigrationRecordStatus {
  PENDING
  VALID
  INVALID
  BLOCKED
  READY
  EXECUTING
  SUCCEEDED
  SKIPPED
  FAILED
  MANUAL_REVIEW
}

model AccountingOrganisationProfile {
  id                      String                  @id @default(cuid())
  orgId                   String                  @unique
  functionalCurrencyCode  String                  @db.VarChar(3)
  fiscalYearStartMonth    Int
  fiscalYearStartDay      Int
  inventoryMode           AccountingInventoryMode
  moneyScale              Int
  quantityScale           Int
  exchangeRateScale       Int
  percentageScale         Int
  roundingMode            AccountingRoundingMode  @default(HALF_UP)
  correctionPolicy        Json?
  correctionPolicyVersion Int?
  rowVersion              Int                     @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId])
}

model AccountingLegalEntity {
  id            String                      @id @default(cuid())
  orgId         String
  code          String
  legalName     String
  entityType    String
  status        AccountingLegalEntityStatus @default(DRAFT)
  isDefault     Boolean                     @default(false)
  effectiveFrom DateTime?                   @db.Date
  effectiveTo   DateTime?                   @db.Date
  rowVersion    Int                         @default(1)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  org                       Organisation                         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  taxRegistrations          AccountingTaxRegistration[]
  sourceSnapshots           AccountingSourceSnapshot[]
  integrationInbox          AccountingIntegrationInbox[]
  integrationOutbox         AccountingIntegrationOutbox[]
  journalEntries            JournalEntry[]
  accounts                  Account[]
  documentPolicies          AccountingDocumentPolicy[]
  documents                 AccountingDocument[]
  payments                  AccountingPayment[]
  scheduledOccurrences      AccountingScheduledOccurrence[]
  counterpartyScopes        AccountingCounterpartyEntityScope[]
  taxProfiles               AccountingTaxProfile[]
  taxRules                  AccountingTaxRule[]
  statutoryReturnProfiles   AccountingStatutoryReturnProfile[]
  statutoryFilingPeriods    AccountingStatutoryFilingPeriod[]
  bankAccounts              AccountingBankAccount[]
  bankStatementImports      AccountingBankStatementImport[]
  bankStatementLines        AccountingBankStatementLine[]
  reconciliationSessions    AccountingReconciliationSession[]
  recurringTemplates        AccountingRecurringTemplate[]
  financialAssets           AccountingFinancialAsset[]
  assetBooks                AccountingAssetBook[]
  depreciationRuns          AccountingDepreciationRun[]
  partners                  AccountingPartner[]
  partnerTerms              AccountingPartnerTerm[]
  appropriations            AccountingAppropriation[]
  budgets                   AccountingBudget[]
  budgetLines               AccountingBudgetLine[]
  sourceMappingProfiles     AccountingSourceMappingProfile[]
  periodCloseRuns           AccountingPeriodCloseRun[]
  reportExportProfiles      AccountingReportExportProfile[]
  portalPublicationProfiles AccountingPortalPublicationProfile[]
  capabilityPolicies        AccountingCapabilityPolicy[]         @relation("AccountingCapabilityPolicyLegalEntity")

  @@unique([orgId, code])
  @@index([orgId, status])
}

model AccountingTaxRegistration {
  id               String    @id @default(cuid())
  orgId            String
  legalEntityId    String
  registrationCode String
  registrationType String
  gstin            String?
  stateCode        String?
  legalName        String?
  tradeName        String?
  effectiveFrom    DateTime? @db.Date
  effectiveTo      DateTime? @db.Date
  isActive         Boolean   @default(false)
  configuration    Json?
  rowVersion       Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org                     Organisation                       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  legalEntity             AccountingLegalEntity              @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  numberSeries            AccountingNumberSeries[]
  taxProfiles             AccountingTaxProfile[]
  taxRules                AccountingTaxRule[]
  statutoryReturnProfiles AccountingStatutoryReturnProfile[]
  statutoryFilingPeriods  AccountingStatutoryFilingPeriod[]
  bankAccounts            AccountingBankAccount[]

  @@unique([orgId, registrationCode])
  @@unique([orgId, gstin])
  @@index([orgId, legalEntityId, isActive])
  @@index([orgId, stateCode])
}

model AccountingPeriod {
  id           String                 @id @default(cuid())
  orgId        String
  fiscalYearId String
  periodNumber Int
  name         String
  startDate    DateTime               @db.Date
  endDate      DateTime               @db.Date
  status       AccountingPeriodStatus @default(OPEN)
  hardLockedAt DateTime?
  rowVersion   Int                    @default(1)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  org            Organisation                  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear                    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lockRequests   AccountingPeriodLockRequest[]
  journalEntries JournalEntry[]
  closeRuns      AccountingPeriodCloseRun[]

  @@unique([fiscalYearId, periodNumber])
  @@unique([orgId, startDate, endDate])
  @@index([orgId, status, startDate, endDate])
  @@index([orgId, fiscalYearId])
}

model AccountingPeriodLockRequest {
  id            String                            @id @default(cuid())
  orgId         String
  periodId      String
  requestedById String
  decidedById   String?
  reason        String
  status        AccountingPeriodLockRequestStatus @default(PENDING)
  requestedAt   DateTime                          @default(now())
  decidedAt     DateTime?
  reopenFrom    DateTime?
  reopenUntil   DateTime?
  appliedAt     DateTime?
  relockedAt    DateTime?
  rowVersion    Int                               @default(1)

  org         Organisation     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  requestedBy User             @relation("AccountingPeriodLockRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?            @relation("AccountingPeriodLockDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([orgId, status, requestedAt])
  @@index([periodId, status])
  @@index([requestedById])
  @@index([decidedById])
}

model AccountingCurrency {
  id            String   @id @default(cuid())
  orgId         String
  code          String   @db.VarChar(3)
  name          String
  symbol        String?
  decimalPlaces Int
  isFunctional  Boolean  @default(false)
  isEnabled     Boolean  @default(true)
  rowVersion    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org             Organisation               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  baseRates       AccountingExchangeRate[]   @relation("AccountingExchangeRateFrom")
  quoteRates      AccountingExchangeRate[]   @relation("AccountingExchangeRateTo")
  accountControls AccountingAccountControl[]

  @@unique([orgId, code])
  @@index([orgId, isEnabled])
}

model AccountingExchangeRate {
  id             String                       @id @default(cuid())
  orgId          String
  fromCurrencyId String
  toCurrencyId   String
  rateDate       DateTime                     @db.Date
  rate           Decimal                      @db.Decimal(30, 12)
  source         String
  status         AccountingExchangeRateStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  rowVersion     Int                          @default(1)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  org          Organisation       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  fromCurrency AccountingCurrency @relation("AccountingExchangeRateFrom", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   AccountingCurrency @relation("AccountingExchangeRateTo", fields: [toCurrencyId], references: [id], onDelete: Restrict)
  approvedBy   User?              @relation("AccountingExchangeRateApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  journals     JournalEntry[]

  @@unique([orgId, fromCurrencyId, toCurrencyId, rateDate, source])
  @@index([orgId, rateDate, status])
  @@index([fromCurrencyId, toCurrencyId, rateDate])
}

model AccountingAccountControl {
  id                 String   @id @default(cuid())
  orgId              String
  accountId          String   @unique
  defaultCurrencyId  String?
  systemRole         String?

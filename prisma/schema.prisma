// ─── Employer: Applications ──────────────────────────────────────────────────

model RecruitApplication {
  id                     String    @id @default(cuid())
  orgId                  String
  applicationNumber      String
  jobOpeningId           String
  candidateId            String
  stage                  String    @default("NEW")
  // NEW | RESUME_REVIEW | SCREENING | SHORTLISTED | ASSESSMENT | INTERVIEW
  // | HIRING_MANAGER_REVIEW | OFFER_APPROVAL | OFFER_SENT | OFFER_ACCEPTED
  // | OFFER_DECLINED | HIRED | REJECTED | WITHDRAWN | ON_HOLD | ARCHIVED
  source                 String?
  resumeVersionId        String?
  submissionSnapshotJson Json? // immutable snapshot when job seeker applied internally
  concurrencyVersion     Int       @default(1)
  deletedAt              DateTime?
  createdById            String
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org              Organisation                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobOpening       RecruitJobOpening                @relation(fields: [jobOpeningId], references: [id])
  candidate        RecruitCandidate                 @relation(fields: [candidateId], references: [id])
  stageHistory     RecruitApplicationStageHistory[]
  screeningAnswers RecruitScreeningAnswer[]
  screeningRuns    RecruitScreeningRun[]
  interviews       RecruitInterview[]
  assessments      RecruitAssessment[]
  offers           RecruitOffer[]
  notes            RecruitNote[]                    @relation("ApplicationNotes")

  @@unique([orgId, applicationNumber])
  @@unique([jobOpeningId, candidateId])
  @@index([orgId, stage])
  @@index([orgId, jobOpeningId])
  @@index([orgId, candidateId])
}

model RecruitApplicationStageHistory {
  id            String   @id @default(cuid())
  applicationId String
  fromStage     String?
  toStage       String
  actorId       String
  reason        String?
  metadata      Json?
  movedAt       DateTime @default(now())

  application RecruitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, movedAt])
}

model RecruitScreeningQuestion {
  id           String  @id @default(cuid())
  jobOpeningId String
  question     String
  type         String  @default("TEXT") // TEXT | BOOLEAN | SCALE | MULTIPLE_CHOICE
  options      Json? // string[] for multiple choice
  required     Boolean @default(false)
  order        Int     @default(0)
}

model RecruitScreeningAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionId    String
  answerText    String?
  answerJson    Json?
  createdAt     DateTime @default(now())

  application RecruitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
}

// ─── Employer: AI Screening ──────────────────────────────────────────────────

model RecruitScreeningRun {
  id              String    @id @default(cuid())
  orgId           String
  applicationId   String
  idempotencyKey  String    @unique // app_id + job_req_version + resume_version + rubric_version + prompt_version
  status          String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED | TIMED_OUT
  triggeredBy     String // MANUAL | AUTOMATION | SCHEDULE
  triggeredById   String?
  automationRunId String?
  jobReqVersion   Int
  resumeVersionId String?
  rubricVersion   String
  promptVersion   String
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  application RecruitApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  result      RecruitScreeningResult?

  @@index([applicationId])
  @@index([orgId])
}

model RecruitScreeningResult {
  id                  String    @id @default(cuid())
  runId               String    @unique
  resumeVersionId     String?
  overallScore        Float
  mandatorySkillScore Float
  preferredSkillScore Float
  experienceScore     Float
  educationScore      Float
  locationScore       Float
  screeningQScore     Float
  matchingEvidence    Json
  missingRequirements Json
  uncertainties       Json
  followUpQuestions   Json
  summary             String
  aiProvider          String
  aiModel             String
  promptVersion       String
  rawOutputJson       Json?
  overrideScore       Float?
  overrideReason      String?
  overrideById        String?
  overrideAt          DateTime?
  createdAt           DateTime  @default(now())

  run           RecruitScreeningRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  resumeVersion RecruitCandidateResume? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([resumeVersionId])
}

// ─── Employer: Interviews ────────────────────────────────────────────────────

model RecruitInterview {
  id                 String    @id @default(cuid())
  orgId              String
  applicationId      String
  roundName          String
  roundNumber        Int       @default(1)
  mode               String    @default("VIDEO") // VIDEO | IN_PERSON | PHONE
  location           String?
  meetingLink        String?
  timezone           String    @default("Asia/Kolkata")
  proposedSlots      Json? // DateTime[]
  scheduledAt        DateTime?
  confirmedAt        DateTime?
  candidateConfirmed Boolean   @default(false)
  status             String    @default("SCHEDULED") // SCHEDULED | CONFIRMED | COMPLETED | CANCELLED | RESCHEDULED
  cancelReason       String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  application RecruitApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panel       RecruitInterviewPanel[]
  feedback    RecruitInterviewFeedback[]

  @@index([applicationId])
  @@index([orgId, scheduledAt])
}

model RecruitInterviewPanel {
  id          String @id @default(cuid())
  interviewId String
  userId      String
  role        String @default("INTERVIEWER") // INTERVIEWER | LEAD | OBSERVER

  interview RecruitInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([interviewId])
}

model RecruitInterviewFeedback {
  id             String    @id @default(cuid())
  interviewId    String
  userId         String
  scorecardJson  Json
  recommendation String? // STRONG_YES | YES | MAYBE | NO | STRONG_NO
  comments       String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interview RecruitInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([interviewId])
}

// ─── Employer: Assessments ───────────────────────────────────────────────────

model RecruitAssessment {
  id            String    @id @default(cuid())
  orgId         String
  applicationId String
  name          String
  type          String    @default("WRITTEN") // WRITTEN | CODING | EXTERNAL | ASSIGNMENT
  instructions  String?
  passThreshold Float?
  dueDate       DateTime? @db.Date
  externalRef   String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application RecruitApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempts    RecruitAssessmentAttempt[]

  @@index([applicationId])
  @@index([orgId])
}

model RecruitAssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | SUBMITTED | EVALUATED | EXPIRED
  score        Float?
  notes        String?
  attachments  Json?
  evaluatorId  String?
  startedAt    DateTime?
  submittedAt  DateTime?
  evaluatedAt  DateTime?
  createdAt    DateTime  @default(now())

  assessment RecruitAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// ─── Employer: Offers ────────────────────────────────────────────────────────

model RecruitOffer {
  id                   String    @id @default(cuid())
  orgId                String
  applicationId        String
  offerNumber          String
  status               String    @default("DRAFT")
  // DRAFT | PENDING_APPROVAL | APPROVED | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN | REVISED
  compensationJson     Json // {basic, hra, allowances, gross, ctc, currency}
  proposedJoiningDate  DateTime? @db.Date
  validUntil           DateTime? @db.Date
  conditions           String?
  approvalFlowJson     Json?
  candidateAccessToken String?   @unique
  candidateTokenExpiry DateTime?
  pdfKey               String?
  docxKey              String?
  revisionOf           String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  application RecruitApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvals   RecruitOfferApproval[]

  @@unique([orgId, offerNumber])
  @@index([applicationId])
  @@index([candidateAccessToken])
  @@index([orgId])
}

model RecruitOfferApproval {
  id         String    @id @default(cuid())
  offerId    String
  approverId String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  offer RecruitOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

// ─── Shared Employer: Notes, Tags, Attachments ───────────────────────────────

model RecruitNote {
  id             String   @id @default(cuid())
  orgId          String
  candidateId    String?
  applicationId  String?
  body           String
  isConfidential Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate   RecruitCandidate?   @relation("CandidateNotes", fields: [candidateId], references: [id], onDelete: SetNull)
  application RecruitApplication? @relation("ApplicationNotes", fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([orgId, candidateId])
  @@index([orgId, applicationId])
}

model RecruitTag {
  id          String   @id @default(cuid())
  orgId       String
  candidateId String?
  label       String
  color       String?
  createdById String
  createdAt   DateTime @default(now())

  candidate RecruitCandidate? @relation("CandidateTags", fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([orgId, candidateId])
}

model RecruitAttachment {
  id            String   @id @default(cuid())
  orgId         String
  candidateId   String?
  applicationId String?
  offerId       String?
  fileKey       String
  fileName      String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  uploadedAt    DateTime @default(now())

  @@index([orgId, candidateId])
  @@index([orgId, applicationId])
}

// ─── Employer: Automation ────────────────────────────────────────────────────

model RecruitAutomationRun {
  id            String    @id @default(cuid())
  orgId         String
  trigger       String // MANUAL | SCHEDULE | INTAKE
  triggeredById String?
  status        String    @default("QUEUED") // QUEUED | RUNNING | PARTIALLY_COMPLETED | COMPLETED | FAILED | CANCELLED | TIMED_OUT
  totalItems    Int       @default(0)
  doneItems     Int       @default(0)
  failedItems   Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  errorSummary  String?
  createdAt     DateTime  @default(now())

  org   Organisation               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items RecruitAutomationRunItem[]

  @@index([orgId, createdAt])
}

model RecruitAutomationRunItem {
  id            String    @id @default(cuid())
  runId         String
  applicationId String
  status        String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | SKIPPED
  errorMessage  String?
  retryCount    Int       @default(0)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  run RecruitAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([applicationId])
}

// ─── Employer: Handoff Package (read-only preview) ───────────────────────────

model RecruitHandoffPackage {
  id                String   @id @default(cuid())
  orgId             String
  applicationId     String   @unique
  candidateSnapshot Json // confirmed candidate data at time of hire
  offerSnapshot     Json // accepted offer details
  documentsJson     Json // file refs
  sourceIds         Json // original source IDs
  generatedAt       DateTime @default(now())
  generatedById     String

  @@index([orgId])
}

// ─── Employer: Audit Events ──────────────────────────────────────────────────

model RecruitAuditEvent {
  id            String   @id @default(cuid())
  orgId         String
  actorId       String
  action        String // e.g. recruit.candidate.created, recruit.application.stage_changed
  entityType    String
  entityId      String
  correlationId String?
  changedFields Json?
  reason        String?
  source        String? // UI | API | AUTOMATION | SYSTEM
  metadata      Json?
  createdAt     DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([actorId])
}

// ─── Job Seeker Workspace (user-private) ─────────────────────────────────────

model RecruitJobSeekerProfile {
  id                  String   @id @default(cuid())
  ownerId             String   @unique
  preferredRoles      String[] @default([])
  preferredIndustries String[] @default([])
  preferredLocations  String[] @default([])
  workplacePreference String   @default("ANY") // REMOTE | HYBRID | ONSITE | ANY
  employmentTypes     String[] @default([])
  seniority           String?
  totalExpYears       Float?
  skills              String[] @default([])
  workAuthorization   String?
  noticePeriodDays    Int?
  compensationMin     Float?
  compensationMax     Float?
  compensationCcy     String   @default("INR")
  relocationOpen      Boolean  @default(false)
  excludedCompanies   String[] @default([])
  jobKeywords         String[] @default([])
  alertsEnabled       Boolean  @default(true)
  alertFrequency      String   @default("WEEKLY") // DAILY | WEEKLY | INSTANT
  profileCompleteness Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner          User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  searchProfiles RecruitJobSearchProfile[]
  baseResumes    RecruitJobSeekerResume[]
  savedJobs      RecruitSavedJob[]
  applications   RecruitJobSeekerApplication[]
  conversations  RecruitCareerConversation[]
  alerts         RecruitJobAlert[]

  @@index([ownerId])
}

model RecruitJobSearchProfile {
  id               String    @id @default(cuid())
  profileId        String
  name             String
  keywords         String[]  @default([])
  locations        String[]  @default([])
  workplaceTypes   String[]  @default([])
  employmentTypes  String[]  @default([])
  minSalary        Float?
  maxSalary        Float?
  resultLimit      Int       @default(20)
  minMatchScore    Float     @default(60)
  enabledProviders String[]  @default([])
  isDefault        Boolean   @default(false)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jsProfile  RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobMatches RecruitJobMatch[]
  alerts     RecruitJobAlert[]

  @@index([profileId])
}

model RecruitJobListing {
  id             String    @id @default(cuid())
  ownerId        String
  source         String // INTERNAL | MANUAL | PROVIDER_NAME
  externalId     String?
  canonicalUrl   String?
  title          String
  company        String
  location       String?
  workplaceType  String?
  employmentType String?
  seniority      String?
  description    String?
  salaryMin      Float?
  salaryMax      Float?
  salaryCcy      String?
  postedAt       DateTime?
  expiresAt      DateTime?
  fetchedAt      DateTime  @default(now())
  rawProvenance  Json?
  isDismissed    Boolean   @default(false)
  isExpired      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  matches RecruitJobMatch[]
  savedBy RecruitSavedJob[]

  @@unique([ownerId, source, externalId])
  @@index([ownerId])
  @@index([ownerId, isDismissed, isExpired])
}

model RecruitSavedJob {
  id        String   @id @default(cuid())
  profileId String
  listingId String
  savedAt   DateTime @default(now())
  notes     String?

  jsProfile RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listing   RecruitJobListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([profileId, listingId])
  @@index([profileId])
}

model RecruitJobMatch {
  id                    String   @id @default(cuid())
  ownerId               String
  searchProfileId       String
  listingId             String
  overallScore          Float
  mandatorySkillMatch   Json
  missingSkills         Json
  experienceAlignment   String?
  locationAlignment     String?
  compensationAlignment String?
  evidence              Json?
  uncertainties         Json?
  suggestedQuestions    Json?
  aiProvider            String?
  aiModel               String?
  promptVersion         String?
  createdAt             DateTime @default(now())

  owner         User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  searchProfile RecruitJobSearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)
  listing       RecruitJobListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([searchProfileId, listingId])
  @@index([ownerId])
  @@index([searchProfileId])
}

model RecruitJobSeekerResume {
  id                String   @id @default(cuid())
  ownerId           String
  profileId         String
  name              String
  fileKey           String
  fileName          String
  mimeType          String
  sizeBytes         Int
  resumeHash        String?
  isBase            Boolean  @default(false)
  masterProfileJson Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner     User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jsProfile RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tailored  RecruitTailoredResume[]
  covers    RecruitCoverLetter[]

  @@index([profileId, isBase])
  @@index([ownerId])
}

model RecruitTailoredResume {
  id                String    @id @default(cuid())
  ownerId           String
  baseResumeId      String
  targetListingId   String?
  targetJobTitle    String?
  targetCompany     String?
  diffJson          Json?
  unsupportedClaims Json?
  ownerApproved     Boolean   @default(false)
  approvedAt        DateTime?
  docxKey           String?
  pdfKey            String?
  aiProvider        String?
  aiModel           String?
  promptVersion     String?
  inputVersion      String?
  generatedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  baseResume RecruitJobSeekerResume @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([baseResumeId])
}

model RecruitCoverLetter {
  id              String    @id @default(cuid())
  ownerId         String
  baseResumeId    String
  targetListingId String?
  targetJobTitle  String?
  targetCompany   String?
  tone            String    @default("PROFESSIONAL") // PROFESSIONAL | ENTHUSIASTIC | CONCISE
  lengthPref      String    @default("MEDIUM") // SHORT | MEDIUM | LONG
  contentText     String?
  docxKey         String?
  pdfKey          String?
  version         Int       @default(1)
  aiProvider      String?
  aiModel         String?
  promptVersion   String?
  ownerApproved   Boolean   @default(false)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  baseResume RecruitJobSeekerResume @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([baseResumeId])
}

model RecruitJobSeekerApplication {
  id                     String    @id @default(cuid())
  ownerId                String
  profileId              String
  listingId              String?
  internalJobId          String?
  jobTitle               String
  company                String
  source                 String?
  applicationUrl         String?
  resumeVersionId        String?
  coverLetterId          String?
  appliedAt              DateTime?
  privateStatus          String    @default("INTERESTED")
  // INTERESTED | SAVED | PREPARING | APPLIED | SCREENING | ASSESSMENT | INTERVIEW | OFFER | ACCEPTED | REJECTED | WITHDRAWN | NO_RESPONSE | ARCHIVED
  publicStatus           String? // allow-listed employer-visible status
  followUpDate           DateTime? @db.Date
  contactPeople          Json?
  compensationNotes      String?
  ownerNotes             String?
  submissionConsentGiven Boolean   @default(false)
  submissionConsentAt    DateTime?
  consentSnapshotJson    Json? // immutable snapshot of what was submitted
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner     User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jsProfile RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([ownerId, privateStatus])
  @@index([profileId])
}

model RecruitJobAlert {
  id               String    @id @default(cuid())
  ownerId          String
  profileId        String
  searchProfileId  String
  name             String
  frequency        String    @default("WEEKLY") // DAILY | WEEKLY | CUSTOM
  deliveryTime     String    @default("09:00")
  timezone         String    @default("Asia/Kolkata")
  maxJobs          Int       @default(10)
  minMatchScore    Float     @default(60)
  includeSources   String[]  @default([])
  excludeSources   String[]  @default([])
  autoTailorResume Boolean   @default(false)
  emailEnabled     Boolean   @default(true)
  inAppEnabled     Boolean   @default(true)
  isActive         Boolean   @default(true)
  lastDeliveredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner         User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jsProfile     RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  searchProfile RecruitJobSearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)

  @@index([ownerId, isActive])
  @@index([frequency, lastDeliveredAt])
}

model RecruitCareerConversation {
  id        String    @id @default(cuid())
  ownerId   String
  profileId String
  title     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jsProfile RecruitJobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  RecruitCareerMessage[]

  @@index([ownerId])
  @@index([profileId])
}

model RecruitCareerMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // USER | ASSISTANT
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation RecruitCareerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model RecruitInterviewPrep {
  id              String   @id @default(cuid())
  ownerId         String
  profileId       String
  targetListingId String?
  targetJobTitle  String?
  targetCompany   String?
  prepPackJson    Json // {questions, outlines, starPrompts, revisionList, questionsToAsk, companyChecklist, notes}
  aiProvider      String?
  aiModel         String?
  promptVersion   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model RecruitPrivateShare {
  id            String    @id @default(cuid())
  ownerId       String
  artifactType  String // RESUME | COVER_LETTER | TAILORED_RESUME | INTERVIEW_PREP
  artifactId    String
  recipientNote String?
  purpose       String?
  token         String    @unique
  expiresAt     DateTime
  accessCount   Int       @default(0)
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([token])
  @@index([expiresAt])
}

// Missing back-relations on User for Job Seeker models
// (declared via @relation name on the owner side above)

// ─── Google Chat Integration ──────────────────────────────────────────────────

model GoogleChatUserLink {
  id                    String    @id @default(cuid())
  userId                String    @unique
  orgId                 String?
  googleUserId          String    @unique
  googleEmail           String?
  googleDisplayName     String?
  googleWorkspaceDomain String?
  linkStatus            String    @default("active")
  verifiedAt            DateTime?
  linkedAt              DateTime  @default(now())
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([googleEmail])
  @@index([linkStatus])
}

model GoogleChatSpace {
  id                  String    @id @default(cuid())
  orgId               String?
  spaceResourceName   String    @unique
  displayName         String?
  spaceType           String    @default("SPACE")
  botMember           Boolean   @default(true)
  linkedByUserId      String?
  linkedRecordType    String?
  linkedRecordId      String?
  linkedRecordLabel   String?
  notificationProfile Json?
  quietHoursStart     String?
  quietHoursEnd       String?
  timezone            String    @default("Asia/Kolkata")
  threadKeys          Json?
  linkStatus          String    @default("active")
  lastVerifiedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org           Organisation?            @relation(fields: [orgId], references: [id], onDelete: SetNull)
  subscriptions GoogleChatSubscription[]
  deliveries    GoogleChatDelivery[]

  @@index([orgId])
  @@index([linkedRecordType, linkedRecordId])
  @@index([linkStatus])
}

model GoogleChatSubscription {
  id          String   @id @default(cuid())
  orgId       String?
  userId      String?
  spaceId     String?
  eventKinds  String[]
  channel     String   @default("DM")
  digestMode  String   @default("immediate")
  digestTime  String?
  minPriority String   @default("normal")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organisation?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  space GoogleChatSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([spaceId])
  @@index([enabled])
}

model GoogleChatDelivery {
  id                  String    @id @default(cuid())
  orgId               String?
  targetSpaceId       String?
  targetUserId        String?
  spaceResourceName   String?
  notificationId      String?
  eventKind           String?
  messageResourceName String?
  threadKey           String?
  threadResourceName  String?
  idempotencyKey      String    @unique
  status              String    @default("queued")
  attempts            Int       @default(0)
  maxAttempts         Int       @default(3)
  lastError           String?
  nextAttemptAt       DateTime?
  sentAt              DateTime?
  payload             Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org   Organisation?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  space GoogleChatSpace? @relation(fields: [targetSpaceId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([orgId])
  @@index([targetUserId])
  @@index([notificationId])
}

model GoogleChatInteractionEvent {
  id                String   @id @default(cuid())
  googleEventId     String   @unique
  spaceResourceName String
  userResourceName  String?
  eventType         String
  processedAt       DateTime @default(now())

  @@index([processedAt])
}

model GoogleChatLinkToken {
  id                String    @id @default(cuid())
  token             String    @unique
  googleUserId      String
  googleEmail       String?
  googleDisplayName String?
  spaceResourceName String?
  orgId             String?
  expectedDomain    String?
  used              Boolean   @default(false)
  usedAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([expiresAt])
  @@index([googleUserId])
}

// ─── Filing Workflow Blueprint Models ────────────────────────────────────────

model FilingWorkflowTemplate {
  id                 String                   @id @default(cuid())
  orgId              String
  clearanceTypeId    String?
  filingFlowCategory String? // IMPORT_BE | EXPORT_SB | CUSTOM — the flow category this template belongs to
  name               String
  description        String?
  settingsJson       Json?
  mailTemplatesJson  Json?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  org                Organisation             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clearanceType      ChaJobType?              @relation(fields: [clearanceTypeId], references: [id], onDelete: SetNull)
  versions           FilingWorkflowVersion[]
  instances          FilingWorkflowInstance[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([clearanceTypeId])
  @@index([orgId, filingFlowCategory])
}

model FilingWorkflowVersion {
  id            String                   @id @default(cuid())
  templateId    String
  versionNumber Int
  isPublished   Boolean                  @default(false)
  isActive      Boolean                  @default(false)
  createdById   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  template      FilingWorkflowTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  nodes         FilingWorkflowNode[]
  edges         FilingWorkflowEdge[]
  instances     FilingWorkflowInstance[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([templateId, versionNumber])
  @@index([templateId, isPublished])
}

model FilingWorkflowNode {
  id                                String                   @id @default(cuid())
  versionId                         String
  key                               String
  name                              String
  description                       String?
  category                          String?
  nodeType                          String                   @default("CHECKLIST_NODE")
  fieldDefinitionsJson              Json?
  documentRequirementsJson          Json?
  conditionalSectionsJson           Json?
  approvalConfigJson                Json?
  notificationConfigJson            Json?
  actionConfigJson                  Json?
  sectionKey                        String?
  sectionName                       String?
  branchKey                         String?
  branchName                        String?
  sortOrder                         Int                      @default(0)
  isActive                          Boolean                  @default(true)
  positionX                         Float                    @default(0)
  positionY                         Float                    @default(0)
  isStart                           Boolean                  @default(false)
  slaDuration                       Int                      @default(2)
  slaUnit                           String                   @default("BUSINESS_DAYS")
  commentsRequired                  Boolean                  @default(false)
  delayRemarksRequired              Boolean                  @default(true)
  canBeSkipped                      Boolean                  @default(false)
  canBeRevisited                    Boolean                  @default(true)
  approvalRequired                  Boolean                  @default(false)
  approvalRoles                     String[]
  requireAllMandatoryChecklistItems Boolean                  @default(true)
  requireMandatoryPhotos            Boolean                  @default(true)
  allowedRoles                      String[]
  version                           FilingWorkflowVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  checklistItems                    FilingChecklistItem[]
  photoRequirements                 FilingPhotoRequirement[]
  nodeRuns                          FilingNodeRun[]
  fieldValues                       FilingFieldValue[]
  toggleStates                      FilingToggleState[]
  queries                           FilingWorkflowQuery[]

  @@unique([versionId, key])
  @@index([versionId])
}

model FilingWorkflowEdge {
  id                   String                @id @default(cuid())
  versionId            String
  sourceKey            String
  targetKey            String
  label                String?
  transitionType       String                @default("FORWARD")
  requiresReason       Boolean               @default(false)
  transitionConfigJson Json?
  version              FilingWorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, sourceKey, targetKey])
  @@index([versionId])
}

model FilingChecklistItem {
  id                    String                    @id @default(cuid())
  nodeId                String
  label                 String
  description           String?
  isMandatory           Boolean                   @default(true)
  requiresRemarks       Boolean                   @default(false)
  allowsUpload          Boolean                   @default(false)
  minUploads            Int                       @default(0)
  maxUploads            Int?
  acceptedFileTypes     String[]
  documentType          String?
  requiresValidity      Boolean                   @default(false)
  validityDuration      Int?
  validityUnit          String?
  warningBeforeDuration Int?
  warningBeforeUnit     String?
  notifyBeforeExpiry    Boolean                   @default(false)
  notificationRoles     String[]
  showInDocumentsPage   Boolean                   @default(true)
  showInTimeline        Boolean                   @default(true)
  deadlineDuration      Int                       @default(2)
  deadlineUnit          String                    @default("BUSINESS_DAYS")
  delayRemarksRequired  Boolean                   @default(true)
  hasPhotoRequirement   Boolean                   @default(false)
  sortOrder             Int                       @default(0)
  isActive              Boolean                   @default(true)
  node                  FilingWorkflowNode        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  responses             FilingChecklistResponse[]
  attachments           FilingAttachment[]        @relation("FilingChecklistItemUploads")

  @@index([nodeId])
}

model FilingPhotoRequirement {
  id                    String             @id @default(cuid())
  nodeId                String
  label                 String
  description           String?
  isMandatory           Boolean            @default(true)
  minPhotos             Int                @default(1)
  maxPhotos             Int?
  acceptedFileTypes     String[]
  isVisibleInTimeline   Boolean            @default(true)
  documentType          String?
  requiresValidity      Boolean            @default(false)
  validityDuration      Int?
  validityUnit          String?
  warningBeforeDuration Int?
  warningBeforeUnit     String?
  notifyBeforeExpiry    Boolean            @default(false)
  notificationRoles     String[]
  showInDocumentsPage   Boolean            @default(true)
  node                  FilingWorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  attachments           FilingAttachment[]

  @@index([nodeId])
}

model FilingWorkflowInstance {
  id             String                    @id @default(cuid())
  jobId          String                    @unique
  templateId     String
  versionId      String
  status         String                    @default("ACTIVE")
  currentNodeKey String?
  contextJson    Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  job            ChaJob                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template       FilingWorkflowTemplate    @relation(fields: [templateId], references: [id])
  version        FilingWorkflowVersion     @relation(fields: [versionId], references: [id])
  nodeRuns       FilingNodeRun[]
  responses      FilingChecklistResponse[]
  attachments    FilingAttachment[]
  fieldValues    FilingFieldValue[]
  toggleStates   FilingToggleState[]
  queries        FilingWorkflowQuery[]

  @@index([jobId])
  @@index([templateId])
  @@index([versionId])
  @@index([status])
}

model FilingNodeRun {
  id              String                    @id @default(cuid())
  instanceId      String
  nodeId          String
  nodeKey         String
  status          String                    @default("ACTIVE")
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  slaDueDate      DateTime?
  completedById   String?
  remarks         String?
  delayRemarks    String?
  delayRemarkedAt DateTime?
  resolutionJson  Json?
  instance        FilingWorkflowInstance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  node            FilingWorkflowNode        @relation(fields: [nodeId], references: [id])
  completedBy     User?                     @relation(fields: [completedById], references: [id])
  responses       FilingChecklistResponse[]
  attachments     FilingAttachment[]
  fieldValues     FilingFieldValue[]
  toggleStates    FilingToggleState[]
  queries         FilingWorkflowQuery[]

  @@index([instanceId])
  @@index([nodeId])
  @@index([completedById])
}

model FilingFieldValue {
  id          String   @id @default(cuid())
  instanceId  String
  nodeRunId   String?
  nodeId      String
  fieldKey    String
  valueJson   Json?
  updatedById String?
  updatedAt   DateTime @updatedAt

  instance  FilingWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeRun   FilingNodeRun?         @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)
  node      FilingWorkflowNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  updatedBy User?                  @relation(fields: [updatedById], references: [id])

  @@unique([instanceId, nodeId, fieldKey])
  @@index([nodeRunId])
  @@index([updatedById])
}

model FilingToggleState {
  id          String   @id @default(cuid())
  instanceId  String
  nodeRunId   String?
  nodeId      String
  sectionKey  String
  isEnabled   Boolean  @default(false)
  stateJson   Json?
  updatedById String?
  updatedAt   DateTime @updatedAt

  instance  FilingWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeRun   FilingNodeRun?         @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)
  node      FilingWorkflowNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  updatedBy User?                  @relation(fields: [updatedById], references: [id])

  @@unique([instanceId, nodeId, sectionKey])
  @@index([nodeRunId])
  @@index([updatedById])
}

model FilingWorkflowQuery {
  id             String    @id @default(cuid())
  instanceId     String
  nodeRunId      String?
  nodeId         String
  title          String
  details        String
  status         String    @default("OPEN")
  reminderTime   String?
  lastReminderAt DateTime?
  closedAt       DateTime?
  createdById    String
  closedById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instance  FilingWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeRun   FilingNodeRun?         @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)
  node      FilingWorkflowNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("FilingWorkflowQueryCreatedBy", fields: [createdById], references: [id])
  closedBy  User?                  @relation("FilingWorkflowQueryClosedBy", fields: [closedById], references: [id])

  @@index([instanceId, status])
  @@index([nodeRunId])
}

model FilingChecklistResponse {
  id              String                 @id @default(cuid())
  instanceId      String
  nodeRunId       String?
  checklistItemId String
  isChecked       Boolean                @default(false)
  remarks         String?
  fileKey         String?
  dueAt           DateTime?
  completedAt     DateTime?
  delayRemarks    String?
  delayRemarkedAt DateTime?
  overdueLoggedAt DateTime?
  updatedAt       DateTime               @updatedAt
  instance        FilingWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeRun         FilingNodeRun?         @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)
  checklistItem   FilingChecklistItem    @relation(fields: [checklistItemId], references: [id])

  @@unique([instanceId, checklistItemId])
  @@index([instanceId])
  @@index([checklistItemId])
}

model FilingAttachment {
  id                       String                  @id @default(cuid())
  instanceId               String
  nodeRunId                String?
  photoRequirementId       String?
  checklistItemId          String?
  documentRequirementKey   String?
  documentRequirementLabel String?
  conditionalSectionKey    String?
  fileKey                  String
  fileName                 String
  fileSize                 Int
  fileType                 String
  uploadedById             String
  uploadedAt               DateTime                @default(now())
  validityDate             DateTime?
  instance                 FilingWorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeRun                  FilingNodeRun?          @relation(fields: [nodeRunId], references: [id], onDelete: Cascade)
  photoRequirement         FilingPhotoRequirement? @relation(fields: [photoRequirementId], references: [id], onDelete: SetNull)
  checklistItem            FilingChecklistItem?    @relation("FilingChecklistItemUploads", fields: [checklistItemId], references: [id], onDelete: SetNull)
  uploadedBy               User                    @relation(fields: [uploadedById], references: [id])

  @@index([instanceId])
  @@index([photoRequirementId])
  @@index([checklistItemId])
  @@index([uploadedById])
}

model FilingSection49Flag {
  id           String    @id @default(cuid())
  jobId        String    @unique
  isEnabled    Boolean   @default(false)
  validityDate DateTime?
  remarks      String?
  toggledById  String
  updatedAt    DateTime  @updatedAt
  job          ChaJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  toggledBy    User      @relation(fields: [toggledById], references: [id])

  @@index([jobId])
  @@index([validityDate, isEnabled])
}

model FilingSection49Extension {
  id               String    @id @default(cuid())
  jobId            String
  previousValidity DateTime?
  extensionDate    DateTime
  fileKey          String?
  fileName         String?
  appliedById      String
  createdAt        DateTime  @default(now())

  job       ChaJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  appliedBy User   @relation(fields: [appliedById], references: [id])

  @@index([jobId, createdAt])
}

// ─── HRMS Mobile Attendance & Tracking ──────────────────────────────────────────

model MobileDevice {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  deviceId   String // Unique device identifier from native app
  platform   String   @default("android") // android | ios | web
  model      String? // e.g. "Samsung Galaxy S24"
  osVersion  String?
  appVersion String?
  pushToken  String? // FCM / APNs token
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation("UserMobileDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([orgId])
  @@index([userId, isActive])
}

model EmployeeFaceEnrollment {
  id             String    @id @default(cuid())
  orgId          String
  userId         String    @unique
  enrollmentData Json // Encrypted face descriptor/embedding data
  enrollmentHash String // Hash for integrity verification
  isActive       Boolean   @default(true)
  enrolledAt     DateTime  @default(now())
  enrolledVia    String    @default("mobile") // mobile | web | admin
  resetById      String? // Admin who last reset enrollment
  resetAt        DateTime?
  auditTrail     Json? // Array of audit entries
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation("FaceEnrollment", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AttendanceSession {
  id                     String    @id @default(cuid())
  orgId                  String
  userId                 String
  date                   DateTime  @db.Date
  checkInAt              DateTime
  checkOutAt             DateTime?
  checkInLocation        Json? // { lat, lng, accuracy, timestamp, address }
  checkOutLocation       Json? // { lat, lng, accuracy, timestamp, address }
  checkInFaceVerified    Boolean   @default(false)
  checkOutFaceVerified   Boolean   @default(false)
  checkInFaceConfidence  Float? // 0.0 to 1.0
  checkOutFaceConfidence Float?
  checkInDeviceId        String?
  checkOutDeviceId       String?
  checkInSource          String    @default("MOBILE") // MOBILE | BIOMETRIC | WEB | ADMIN
  checkOutSource         String?
  checkInIp              String?
  checkOutIp             String?
  trackingEnabled        Boolean   @default(false)
  status                 String    @default("ACTIVE") // ACTIVE | CLOSED | AUTO_CLOSED
  closedReason           String? // checkout | shift_end | admin_close | auto_close
  workingMinutes         Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user             User                      @relation("AttendanceSessions", fields: [userId], references: [id], onDelete: Cascade)
  trackingSessions LocationTrackingSession[] @relation("SessionTrackingSessions")

  @@index([orgId, date])
  @@index([userId, date])
  @@index([userId, status])
}

model LocationTrackingSession {
  id                  String    @id @default(cuid())
  orgId               String
  userId              String
  attendanceSessionId String?
  onDutyRequestId     String?
  startedAt           DateTime  @default(now())
  stoppedAt           DateTime?
  intervalMinutes     Int       @default(60) // 60 for hourly, 5 for on-duty
  status              String    @default("ACTIVE") // ACTIVE | PAUSED | STOPPED
  stopReason          String? // checkout | shift_end | on_duty_complete | admin_stop | auto_stop
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User               @relation("UserTrackingSessions", fields: [userId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession? @relation("SessionTrackingSessions", fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  onDutyRequest     OnDutyRequest?     @relation("OnDutyTrackingSessions", fields: [onDutyRequestId], references: [id], onDelete: SetNull)
  locationPoints    LocationPoint[]
  alerts            TrackingAlert[]    @relation("TrackingSessionAlerts")

  @@index([orgId, status])
  @@index([userId, status])
}

model LocationPoint {
  id                String   @id @default(cuid())
  trackingSessionId String
  latitude          Float
  longitude         Float
  accuracy          Float? // meters
  altitude          Float?
  speed             Float? // m/s
  bearing           Float? // degrees
  timestamp         DateTime
  batteryLevel      Float? // 0-100
  deviceId          String?
  networkStatus     String? // wifi | cellular | offline
  source            String   @default("HOURLY") // HOURLY | ON_DUTY | CHECK_IN | CHECK_OUT | MANUAL
  isMocked          Boolean  @default(false)
  createdAt         DateTime @default(now())

  trackingSession LocationTrackingSession @relation(fields: [trackingSessionId], references: [id], onDelete: Cascade)

  @@index([trackingSessionId, timestamp])
  @@index([timestamp])
}

model TrackingAlert {
  id                String    @id @default(cuid())
  orgId             String
  userId            String
  trackingSessionId String?
  onDutyRequestId   String?
  alertType         String // OFFLINE | GPS_DISABLED | PERMISSION_DENIED | APP_KILLED | LOW_BATTERY | MOCK_DETECTED
  lastKnownLat      Float?
  lastKnownLng      Float?
  lastUpdateAt      DateTime?
  message           String?
  resolvedAt        DateTime?
  notifiedManagerId String?
  notifiedAdminId   String?
  createdAt         DateTime  @default(now())

  user            User                     @relation("UserTrackingAlerts", fields: [userId], references: [id], onDelete: Cascade)
  trackingSession LocationTrackingSession? @relation("TrackingSessionAlerts", fields: [trackingSessionId], references: [id], onDelete: SetNull)

  @@index([orgId, alertType])
  @@index([userId, resolvedAt])
}

model FuelReimbursementPolicy {
  id            String    @id @default(cuid())
  orgId         String
  ratePerKm     Float     @default(3.75) // ₹3.75/km default
  currency      String    @default("INR")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orgId, isActive])
}

model FuelReimbursementClaim {
  id              String    @id @default(cuid())
  orgId           String
  userId          String
  onDutyRequestId String
  distanceKm      Float
  ratePerKm       Float // Snapshot of rate at time of claim
  amount          Float // distanceKm × ratePerKm
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  paidAt          DateTime?
  paidById        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation("UserFuelClaims", fields: [userId], references: [id], onDelete: Cascade)
  onDutyRequest OnDutyRequest @relation("OnDutyFuelClaims", fields: [onDutyRequestId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([userId, status])
}

// ─── User Agreement / Consent ───────────────────────────────────────────────────

model UserAgreementVersion {
  id            String   @id @default(cuid())
  orgId         String
  version       Int
  title         String
  content       String // Full legal text
  contentHash   String // SHA-256 of content for integrity
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())

  acceptances UserAgreementAcceptance[]

  @@unique([orgId, version])
  @@index([orgId, isActive])
}

model UserAgreementAcceptance {
  id                 String   @id @default(cuid())
  orgId              String
  userId             String
  agreementVersionId String
  acceptedAt         DateTime @default(now())
  ipAddress          String?
  deviceId           String?
  userAgent          String?
  createdAt          DateTime @default(now())

  user             User                 @relation("UserAgreementAcceptances", fields: [userId], references: [id], onDelete: Cascade)
  agreementVersion UserAgreementVersion @relation(fields: [agreementVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementVersionId])
  @@index([orgId])
}

model Unit {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

{
  "name": "monolith-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-local-dev.mjs --turbopack",
    "dev:restart": "node scripts/start-local-dev.mjs --turbopack --restart",
    "dev:webpack": "node scripts/start-local-dev.mjs --webpack",
    "dev:turbopack": "node scripts/start-local-dev.mjs --turbopack",
    "dev:preflight": "node scripts/start-local-dev.mjs --turbopack --with-preflight",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "worker:justdial": "tsx scripts/justdial-worker.ts",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "accounting:schema:verify": "tsx scripts/verify-accounting-database-schema.ts",
    "accounting:schema:preflight": "tsx scripts/deploy-accounting-schema.ts --verify-only",
    "accounting:schema:deploy": "tsx scripts/deploy-accounting-schema.ts",
    "accounting:ui:verify": "node scripts/verify-monolith-accounting-runtime.mjs",
    "deploy:accounting-safe": "npm run accounting:schema:deploy && npm run build",
    "env:database:check": "tsx scripts/show-safe-database-target.ts",
    "ui:app:check": "node scripts/verify-local-app-start.mjs",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "staging:db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-db.ps1 setup",
    "staging:db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-db.ps1 start",
    "staging:db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-db.ps1 stop",
    "staging:db:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-db.ps1 health",
    "staging:db:recreate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-db.ps1 recreate",
    "staging:db:migrate": "tsx scripts/run-with-staging-env.ts prisma migrate deploy",
    "staging:db:status": "tsx scripts/run-with-staging-env.ts prisma migrate status",
    "staging:db:seed": "tsx scripts/run-with-staging-env.ts tsx prisma/seed.staging.ts",
    "staging:db:verify": "tsx scripts/run-with-staging-env.ts tsx scripts/verify-staging-db.ts",
    "staging:app:check": "node scripts/disabled-staging-web-server.mjs",
    "staging:login:verify": "node scripts/disabled-staging-web-server.mjs",
    "staging:dev": "tsx scripts/run-with-staging-env.ts next dev --webpack -H 127.0.0.1 -p 3100",
    "staging:test": "tsx scripts/run-with-staging-env.ts vitest run",
    "db:bootstrap:cha-admin": "npx tsx scripts/bootstrap-cha-test-admin.ts",
    "db:bootstrap:special-accounts": "npx tsx scripts/bootstrap-special-accounts.ts",
    "db:studio": "prisma studio",
    "import:employees": "npx tsx scripts/import-employees.ts",
    "accounting:migration": "tsx scripts/migrate-accounting-data.ts",
    "accounting:readiness": "tsx scripts/accounting-phase6-readiness.ts",
    "accounting:readiness:staging": "tsx scripts/run-with-staging-env.ts tsx scripts/capture-accounting-readiness-staging.ts --org-id=stg_org_monolith_accounting --legal-entity-id=stg_accounting_legal_entity",
    "accounting:post-cutover": "tsx scripts/accounting-phase6-post-cutover.ts",
    "accounting:phase6:verify": "node scripts/verify-accounting-phase6-static.mjs",
    "accounting:phase6:benchmark": "tsx scripts/benchmark-accounting-phase6.ts --records=2000",
    "accounting:deployment:verify": "node scripts/verify-accounting-deployment-readiness.mjs",
    "accounting:phase6:staging-preflight": "tsx scripts/run-with-staging-env.ts tsx scripts/preflight-accounting-phase6-staging.ts",
    "accounting:phase6:safety-scan": "node scripts/scan-accounting-phase6-safety.mjs",
    "accounting:phase7:verify": "node scripts/verify-accounting-phase7-static.mjs",
    "accounting:phase7:readiness": "tsx scripts/accounting-phase7-readiness.ts",
    "accounting:phase7:rehearsal": "tsx scripts/accounting-phase7-rehearsal.ts",
    "accounting:phase7:benchmark": "tsx scripts/benchmark-accounting-phase7.ts",
    "accounting:phase7:safety-scan": "node scripts/scan-accounting-phase6-safety.mjs",
    "accounting:phase8:verify": "node scripts/verify-accounting-phase8-static.mjs",
    "accounting:phase8:readiness": "tsx scripts/accounting-phase8-readiness.ts",
    "accounting:phase8:benchmark": "tsx scripts/benchmark-accounting-phase8.ts",
    "accounting:phase9:verify": "node scripts/verify-accounting-phase9-static.mjs",
    "accounting:phase9:test": "vitest run src/modules/accounting/__tests__/phase9-capability-policy.test.ts src/modules/accounting/__tests__/phase9-capability-policy-actions.test.ts",
    "accounting:phase9:benchmark": "tsx scripts/benchmark-accounting-phase9.ts",
    "accounting:phase9:safety-scan": "node scripts/scan-accounting-phase9-safety.mjs",
    "fix:employee-org": "npx tsx scripts/fix-employee-org-structure.ts",
    "integrate:mails": "npx tsx scripts/bulk-integrate-emails.ts",
    "seed:comm-panels": "npx tsx scripts/seed-communication-panels.ts",
    "catalogue:update": "npx tsx scripts/update-product-catalogue.ts",
    "catalogue:check": "npx tsx scripts/check-product-catalogue.ts",
    "test": "tsx scripts/run-with-staging-env.ts vitest run",
    "test:mona": "vitest run --config vitest.mona.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "smoke:test": "node scripts/vercel-smoke-test.mjs",
    "test:playwright:performance": "node scripts/playwright-performance-security.mjs",
    "test:design-system:parity": "node scripts/verify-monolith-design-system-runtime.mjs",
    "architecture:check": "node scripts/verify-code-organization.mjs",
    "audit:structure": "npm run architecture:check",
    "design-system:verify": "node scripts/verify-design-system-coverage.mjs && node scripts/verify-catalogue-style-boundary.mjs",
    "audit:unused": "npx tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "security:audit-gate": "node scripts/security-audit-gate.mjs",
    "security:coverage": "node scripts/scan-route-auth-coverage.mjs && node scripts/scan-tenant-scope-coverage.mjs && node scripts/scan-authz-matrix.mjs > /dev/null",
    "security:test": "vitest run --config vitest.unit.config.ts src/lib/__tests__/safe-fetch.test.ts src/lib/__tests__/safe-redirect.test.ts src/lib/__tests__/request-integrity.test.ts src/lib/__tests__/upload-validation.test.ts src/lib/__tests__/security-headers.test.ts src/lib/__tests__/security.test.ts src/lib/__tests__/api-auth.test.ts src/lib/__tests__/session-fail-closed.test.ts src/lib/__tests__/tenant.test.ts src/lib/__tests__/tenant-scope-coverage.test.ts src/lib/__tests__/route-auth-coverage.test.ts src/lib/__tests__/rbac.test.ts src/lib/__tests__/oauth-linking.test.ts src/lib/__tests__/step-up.test.ts src/lib/__tests__/password-reset-token.test.ts src/lib/__tests__/workspace-token-encryption.test.ts src/lib/mfa/__tests__",
    "security:check": "npm run security:coverage && npm run security:test && npm run security:audit-gate",
    "quality": "npm run audit:structure && npm run design-system:verify && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.80.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-pdf/renderer": "^4.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "mssql": "^12.5.5",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.1.1",
    "pg": "^8.20.0",
    "playwright": "^1.61.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.12.3",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "undici": "^7.29.0",
    "sharp": "^0.35.4",
    "valibot": "^1.4.2",
    "postcss": "^8.5.26"
  }
}

# Safe local staging only. Copying this file manually is optional:
# `npm run staging:db:setup` creates `.env.staging.local` with generated secrets.
MONOLITH_ENV=staging
STAGING_MARKER=MONOLITH_ACCOUNTING_STAGING_ONLY
STAGING_DATABASE_HOST=127.0.0.1
STAGING_DATABASE_PORT=56432
STAGING_DATABASE_NAME=monolith_accounting_staging
STAGING_DATABASE_ADMIN_USER=monolith_staging_admin
STAGING_DATABASE_ADMIN_PASSWORD=generate-a-strong-local-secret
STAGING_DATABASE_USER=monolith_staging
STAGING_DATABASE_PASSWORD=generate-a-different-strong-local-secret
DATABASE_URL=postgresql://monolith_staging:replace-with-url-safe-local-secret@127.0.0.1:56432/monolith_accounting_staging?schema=public
AUTH_SECRET=generate-a-strong-local-secret
STAGING_TEST_PASSWORD=generate-a-strong-local-test-password
CRON_SECRET=generate-a-strong-local-secret
NEXTAUTH_URL=http://localhost:3100
APP_URL=http://localhost:3100
MONOLITH_NEXT_DIST_DIR=.monolith-staging/next
EMAIL_PROVIDER=disabled
EMAIL_FROM=staging@staging.example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ERPNEXT_HOST=
ERPNEXT_PORT=
ERPNEXT_IP=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ESSL_DB_SERVER=
ESSL_DB_PORT=
ESSL_DB_NAME=
ESSL_DB_USER=
ESSL_DB_PASSWORD=
JUSTDIAL_HEADLESS=true
GEMINI_API_KEY=
RECRUIT_MODULE_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_CHAT_BOT_NAME=
GOOGLE_CHAT_SA_EMAIL=
GOOGLE_CHAT_SA_PRIVATE_KEY_ID=
GOOGLE_CHAT_SA_PRIVATE_KEY=
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_LINK_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

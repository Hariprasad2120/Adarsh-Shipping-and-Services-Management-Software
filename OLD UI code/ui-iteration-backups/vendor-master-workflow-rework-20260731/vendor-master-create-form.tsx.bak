"use client";

import { Loader2, Save } from "lucide-react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useMemo, useState } from "react";
import { toast } from "sonner";
import { NativeSelect } from "@/components/monolith/native-select";
import {
  createVendorAction,
  fetchGstDetailsAction,
} from "@/modules/crm/actions";
import {
  GST_PUBLIC_SEARCH_URL,
  isGstLookupConfigurationError,
} from "@/lib/gst-public-search";

type EmployeeOption = {
  id: string;
  name: string;
};

type VendorMasterCreateFormProps = {
  employees: EmployeeOption[];
};

type VendorFormState = {
  name: string;
  contactName: string;
  phone: string;
  email: string;
  gstin: string;
  services: string;
  address: string;
  ownerId: string;
};

function formatFetchedAddress(address: {
  street1?: string;
  street2?: string;
  city?: string;
  state?: string;
  pincode?: string;
  country?: string;
} | null | undefined) {
  if (!address) return "";

  const street = [address.street1, address.street2]
    .filter(Boolean)
    .join(", ");
  const locality = [address.city, address.state, address.pincode]
    .filter(Boolean)
    .join(", ");

  return [street, locality, address.country].filter(Boolean).join(", ");
}

export function VendorMasterCreateForm({
  employees,
}: VendorMasterCreateFormProps) {
  const router = useRouter();
  const defaultOwnerId = useMemo(() => employees[0]?.id ?? "", [employees]);
  const initialState = useMemo<VendorFormState>(
    () => ({
      name: "",
      contactName: "",
      phone: "",
      email: "",
      gstin: "",
      services: "",
      address: "",
      ownerId: defaultOwnerId,
    }),
    [defaultOwnerId],
  );
  const [form, setForm] = useState<VendorFormState>(initialState);
  const [isSaving, setIsSaving] = useState(false);
  const [lastFetchedGstin, setLastFetchedGstin] = useState("");
  const [gstManualFallback, setGstManualFallback] = useState(false);

  function update<K extends keyof VendorFormState>(
    key: K,
    value: VendorFormState[K],
  ) {
    setForm((current) => ({ ...current, [key]: value }));
  }

  async function handleGstinChange(value: string) {
    const cleanGstin = value.trim().toUpperCase();
    update("gstin", cleanGstin);

    if (cleanGstin.length !== 15 || cleanGstin === lastFetchedGstin) {
      return;
    }

    setLastFetchedGstin(cleanGstin);
    setGstManualFallback(false);

    const request = fetchGstDetailsAction(cleanGstin).then((result) => {
      if (!result.ok) {
        if (isGstLookupConfigurationError(result.error)) {
          setGstManualFallback(true);
          throw new Error(
            "Automatic GST lookup is unavailable right now. Use Verify on GST Portal to confirm and copy the details manually.",
          );
        }
        throw new Error(result.error || "Failed to fetch GST details");
      }

      const details = result.data as
        | {
            legalName?: string;
            tradeName?: string;
            billingAddress?: {
              street1?: string;
              street2?: string;
              city?: string;
              state?: string;
              pincode?: string;
              country?: string;
            };
          }
        | undefined;

      if (!details) {
        throw new Error("GST registration details were empty");
      }

      setForm((current) => ({
        ...current,
        gstin: cleanGstin,
        name: details.tradeName || details.legalName || current.name,
        address:
          formatFetchedAddress(details.billingAddress) || current.address,
      }));

      return details.tradeName || details.legalName || "GST registration details loaded";
    });

    toast.promise(request, {
      loading: "Fetching GST registration details...",
      success: (message) => `Auto-populated vendor master for ${message}`,
      error: (error) =>
        error instanceof Error
          ? error.message
          : "Failed to fetch GST details",
    });
  }

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setIsSaving(true);

    try {
      const payload = new FormData();
      payload.set("name", form.name.trim());
      payload.set("contactName", form.contactName.trim());
      payload.set("phone", form.phone.trim());
      payload.set("email", form.email.trim());
      payload.set("gstin", form.gstin.trim().toUpperCase());
      payload.set("services", form.services.trim());
      payload.set("address", form.address.trim());
      payload.set("ownerId", form.ownerId);

      const result = await createVendorAction(payload);
      if (!result.ok) {
        toast.error(result.error || "Failed to save vendor");
        return;
      }

      toast.success("Vendor master saved");
      setForm(initialState);
      setLastFetchedGstin("");
      router.refresh();
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Failed to save vendor",
      );
    } finally {
      setIsSaving(false);
    }
  }

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          Vendor Company Name *
        </label>
        <input
          type="text"
          value={form.name}
          onChange={(event) => update("name", event.target.value)}
          placeholder="e.g. South Linehaul Packers"
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
          required
        />
      </div>

      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          Contact Person
        </label>
        <input
          type="text"
          value={form.contactName}
          onChange={(event) => update("contactName", event.target.value)}
          placeholder="e.g. Ramesh Kumar"
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
        />
      </div>

      <div className="grid grid-cols-2 gap-3">
        <div>
          <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
            Phone
          </label>
          <input
            type="text"
            value={form.phone}
            onChange={(event) => update("phone", event.target.value)}
            placeholder="e.g. +91 94440 12345"
            className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
          />
        </div>
        <div>
          <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
            Email
          </label>
          <input
            type="email"
            value={form.email}
            onChange={(event) => update("email", event.target.value)}
            placeholder="e.g. ramesh@vendor.com"
            className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          GSTIN / Tax ID
        </label>
        <input
          type="text"
          value={form.gstin}
          onChange={(event) => void handleGstinChange(event.target.value)}
          placeholder="e.g. 33AABCA1234F1Z1"
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs uppercase text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
        />
        <p className="mt-1 text-[10px] text-mono-muted">
          Enter a full 15-character GSTIN to auto-populate the registered name
          and billing address.
        </p>
        <div className="mt-1.5 flex flex-wrap items-center gap-2 text-[10px]">
          <Link
            href={GST_PUBLIC_SEARCH_URL}
            target="_blank"
            rel="noreferrer"
            className="font-semibold text-[var(--mnx-accent)] hover:underline"
          >
            Verify on GST Portal
          </Link>
          <span className="text-mono-muted">
            Public lookup requires manual captcha verification.
          </span>
        </div>
        {gstManualFallback ? (
          <p className="mt-1 text-[10px] text-mono-muted">
            Auto-fetch is not configured for this environment yet. Use the GST
            Portal link above to verify the GSTIN and enter the details
            manually.
          </p>
        ) : null}
      </div>

      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          Services Provided
        </label>
        <input
          type="text"
          value={form.services}
          onChange={(event) => update("services", event.target.value)}
          placeholder="e.g. Custom clearance, Linehaul trucking"
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
        />
      </div>

      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          Address
        </label>
        <input
          type="text"
          value={form.address}
          onChange={(event) => update("address", event.target.value)}
          placeholder="Street office address..."
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-text focus:border-[var(--mnx-accent)] focus:outline-none"
        />
      </div>

      <div>
        <label className="mb-1.5 block text-[10px] font-bold uppercase tracking-wider text-mono-muted">
          Vendor Owner *
        </label>
        <NativeSelect
          value={form.ownerId}
          onChange={(event) => update("ownerId", event.target.value)}
          className="w-full rounded border border-[var(--mnx-border)] bg-[var(--mnx-surface)] px-3 py-1.5 text-xs text-mono-muted focus:border-[var(--mnx-accent)] focus:outline-none"
          required
        >
          {employees.map((employee) => (
            <option key={employee.id} value={employee.id}>
              {employee.name}
            </option>
          ))}
        </NativeSelect>
      </div>

      <button
        type="submit"
        disabled={isSaving}
        className="mnx-shadow-panel flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-[var(--mnx-accent)] py-2 text-xs font-bold text-mono-text transition-all hover:bg-[var(--mnx-accent)] disabled:cursor-not-allowed disabled:opacity-60"
      >
        {isSaving ? (
          <Loader2 className="size-4 animate-spin" />
        ) : (
          <Save className="size-4" />
        )}
        <span>{isSaving ? "Saving Vendor..." : "Save Vendor Details"}</span>
      </button>
    </form>
  );
}
